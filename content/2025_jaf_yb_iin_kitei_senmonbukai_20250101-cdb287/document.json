   "clause": "第２条",
   "id": "第-条-専門部会の設置"
  },
  {
   "type": "paragraph",
   "page": 1,
   "bbox": [
    36.9,
    262.5,
    239.5,
    275.5
   ],
   "text": "前条の目的のため、下記の専門部会を置く。"
  },
