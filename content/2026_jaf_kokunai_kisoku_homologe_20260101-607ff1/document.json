    381.5,
    300.5,
    394.5
   ],
   "text": "第４編　　カーボンニュートラル活動に関する共通規定",
   "level": 1,
   "clause": "第４編",
   "id": "第-編-カーボンニュートラル活動に関する共通規定"
  },
  {
   "type": "heading",
